# Copia este archivo como .env y llena los valores. NUNCA subas .env a GitHub.

# Bot y grupo de Telegram (el ID de un grupo es un numero negativo, ej. -1001234567890)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Claves de partida especifica a vigilar, separadas por coma
CLAVES_PARTIDA=32401,53101

# Zona horaria y hora de corte: antes de esta hora se busca el dia anterior
ZONA_HORARIA=America/Mexico_City
HORA_CORTE_MANANA=10

# Portal (ajustar solo si cambia la direccion)
COMPRASMX_URL=https://comprasmx.buengobierno.gob.mx/sitiopublico/#/

# 1 = navegador sin ventana (servidor). 0 = ver el navegador (para depurar)
HEADLESS=1

# 1 = el navegador no descarga imagenes/fuentes/video (menos carga si comparte equipo con otro bot)
MODO_LIGERO=1
# Segundos de espera antes de reintentar una vez si la revision falla (equipo ocupado, portal lento)
REINTENTO_SEG=90
